# Copy to .env.local (git-ignored) and fill in what you need. All values are optional.

# Local development only: pre-fills your YouTube Data API key.
# Never set this on a public host; it would be visible to everyone.
VITE_YOUTUBE_KEY=

# Optional shared key server: /api/youtube on Vercel, or a Cloudflare Worker URL (see "Sharing one key with friends" in README.md).
VITE_YOUTUBE_PROXY=

# Server only, for the built-in Vercel shared server (api/youtube.js). Never prefix it with VITE_.
# YOUTUBE_API_KEY=

# Optional Google sign-in and sync (see "Setting up sign-in and sync" in README.md).
# These Firebase values are public by design; firestore.rules protects each person's data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
