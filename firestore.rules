rules_version = '2';

// Aether sync: each signed-in person can read and write only their own library document.
// Paste these into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['library', 'enc', 'device', 'v', 'updatedAt'])
        && request.resource.data.enc in ['deflate', 'json']
        && request.resource.data.library.size() < 1000000;
    }
  }
}
